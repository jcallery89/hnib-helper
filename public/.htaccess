# Cache policy for the tournament tool (this folder only).
#
# index.html must never be served stale: it points at content-hashed asset
# files (assets/index-XXXX.js) that change on every deploy, and a cached copy
# referencing a removed hash renders a white page. The hashed assets themselves
# are immutable and safe to cache hard.
<IfModule mod_headers.c>
  <Files "index.html">
    Header set Cache-Control "no-cache, must-revalidate"
  </Files>
  <FilesMatch "\.(js|css|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
